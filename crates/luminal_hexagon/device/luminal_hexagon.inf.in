[Version]
Signature   = "$WINDOWS NT$"
Class       = ComputeAccelerator
ClassGuid   = {F01A9D53-3FF6-48D2-9F97-C8A7004BE10C}
Provider    = %LUMINAL_HEXAGON%
DriverVer   = 01/01/2026,1.0.0.0
CatalogFile = libluminal-hexagon.cat
PnpLockDown = 1

[DestinationDirs]
Drivers_Dir = 13

[SourceDisksNames]
1 = %DiskId%

[SourceDisksFiles]
libluminal-hexagon-@DSP_VERSION@.so = 1

[ControlFlags]
ExcludeFromSelect = *

[DefaultInstall.NTarm64]
CopyFiles=Drivers_Dir

[Drivers_Dir]
libluminal-hexagon-@DSP_VERSION@.so,,,0x10

[Strings]
LUMINAL_HEXAGON = 'luminal_hexagon'
DiskId         = 'Luminal Hexagon HVX kernel library'
